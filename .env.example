# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-21

# Server-only Sanity tokens (fill these in from https://sanity.io/manage -> API -> Tokens)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Sanity Context MCP endpoint (filled in after publishing the Context document)
SANITY_CONTEXT_MCP_URL=

# OpenRouter (AI concierge)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
